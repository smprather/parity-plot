__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# build artifacts
dist/
build/

# generated example data and rendered plots
data/
*.html
# `templates/*.html` would be anchored to this file's own directory (a pattern
# with a mid-string slash always is), so it missed nested template dirs like
# examples/tabbed-report/templates/. The leading **/ un-anchors it.
!**/templates/*.html
*.png
*.svg
*.pdf
out/

# committed README screenshots (override the global *.png ignore)
!docs/images/
!docs/images/*.png

# throwaway designer configs made while experimenting (config1.toml, ...).
# The committed sample config is parity.toml / EXAMPLE_TOML, never config*.toml.
config*.toml
